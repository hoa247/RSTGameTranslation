<Window x:Class="RSTGameTranslation.ChatBoxWindow"         
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RSTGameTranslation"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Title]}"
        Height="300" Width="980" MinWidth="200" MinHeight="120"
        Topmost="True"
        AllowsTransparency="True"
        Background="#80000000"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Icon="/media/AppIcon.ico">
    
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" CaptionHeight="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Style for button on title bar -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CC2D4C70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Margin}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3E6999"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF2A4A6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style for close button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CCE63232"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFF4C4C"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFC42B2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style for toggle borders button -->
        <Style x:Key="ToggleBordersButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#80404040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A0606060"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A0303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style scroll bar -->
        <Style x:Key="CustomScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="#99FFFFFF" RadiusX="3" RadiusY="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CustomScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Rectangle Width="8" Fill="#33000000"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CustomScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <!-- Header/title bar - always has minimum opacity -->
        <Border x:Name="headerBar" MinHeight="28" VerticalAlignment="Top" Background="#CC202020"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                SizeChanged="HeaderBar_SizeChanged"
                Panel.ZIndex="1"
                CornerRadius="0,0,0,0">
            <DockPanel LastChildFill="True">
                <Button Content="X" Width="28" Height="28"
                        DockPanel.Dock="Right" VerticalAlignment="Top"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_Close_Tooltip]}"/>
                <!-- Customizable toolbar: WrapPanel so buttons flow to a new row when the window narrows.
                     Buttons carry a stable Tag id; order/visibility is driven by ApplyToolbarLayout() from
                     config (customize via Options → "Tùy chỉnh thanh nút"). -->
                <WrapPanel x:Name="toolbarPanel" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Header_RecentText]}" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"/>
                    <Button x:Name="cbSelectAreaButton" Tag="selectArea" Content="⬚ Chọn vùng" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="SelectAreaButton_Click"
                            ToolTip="Chọn vùng dịch mới (giống phím tắt Alt + Q)"/>
                    <Button x:Name="cbShowAreaButton" Tag="showArea" Content="▦ Vùng" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="ShowAreaButton_Click"
                            ToolTip="Hiện / ẩn viền vùng đang chọn"/>
                    <Button x:Name="cbCancelButton" Tag="cancel" Content="✕ Hủy" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="CancelButton_Click"
                            ToolTip="Hủy request đang gửi (khi mạng lâu / treo)"/>
                    <Button x:Name="cbRetryButton" Tag="retry" Content="↻ Dịch lại" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="RetryButton_Click"
                            ToolTip="Dịch lại màn hiện tại (khi lỗi mạng / dịch sai)"/>
                    <Button x:Name="cbTtsButton" Tag="tts" Content="🔊 Đọc" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="TtsButton_Click"
                            ToolTip="Đọc bản dịch thành tiếng (TTS) — bật/tắt"/>
                    <Button x:Name="cbStartStopButton" Tag="startStop" Content="▶ Start" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="StartStopButton_Click"
                            ToolTip="Bắt đầu / Dừng dịch (không cần mở app chính)"/>
                    <Button x:Name="historyButton" Tag="history" Content="Lịch sử" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HistoryButton_Click"
                            ToolTip="Xem lại tất cả bản dịch trước đó (học tiếng Anh / nhớ ngữ cảnh)"/>
                    <Button x:Name="optionsButton" Tag="options" Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_Options]}" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="OptionsButton_Click"
                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_Options_Tooltip]}"/>
                    <Button x:Name="modeButton" Tag="mode" Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_Mode_TranslatedText]}" MinWidth="50" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="ModeButton_Click"
                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_Mode_Tooltip]}"/>
                    <Button x:Name="clearButton" Tag="clear" Content="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_Clear]}" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="ClearButton_Click"
                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_Clear_Tooltip]}"/>
                    <Button x:Name="fontDecreaseButton" Tag="fontDecrease" Content="A-" Width="34" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="FontDecreaseButton_Click"
                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_FontDecrease_Tooltip]}"/>
                    <Button x:Name="fontIncreaseButton" Tag="fontIncrease" Content="A+" Width="34" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="FontIncreaseButton_Click"
                            ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_FontIncrease_Tooltip]}"/>
                    <!-- Extra actions, hidden by default; enable via the customize dialog -->
                    <Button x:Name="cbOverlayButton" Tag="overlay" Content="📺 Lớp phủ" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="OverlayButton_Click"
                            ToolTip="Bật / tắt lớp phủ (Overlay)"/>
                    <Button x:Name="cbAudioButton" Tag="audio" Content="🎤 Âm thanh" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="AudioButton_Click"
                            ToolTip="Bật / tắt Dịch âm thanh (STT) — thử nghiệm"/>
                    <Button x:Name="cbOneOffButton" Tag="oneOff" Content="🎯 Dịch 1 lần" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="OneOffButton_Click"
                            ToolTip="Chọn 1 vùng bất kỳ trên màn hình rồi dịch DUY NHẤT 1 lần (không đổi vùng mặc định)"/>
                    <!-- Global-hotkey actions (all hidden by default; enable via customize dialog) -->
                    <Button x:Name="cbToggleChatBoxButton" Tag="toggleChatBox" Content="💬 Hộp thoại" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Bật / tắt hộp thoại (Alt + C)"/>
                    <Button x:Name="cbSettingsButton" Tag="settings" Content="⚙ Cài đặt" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Mở cài đặt (Alt + P)"/>
                    <Button x:Name="cbLogButton" Tag="log" Content="📋 Nhật ký" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Bật / tắt nhật ký (Alt + L)"/>
                    <Button x:Name="cbSwapLangButton" Tag="swapLang" Content="🔁 Đổi ngôn ngữ" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Đổi ngôn ngữ nguồn ↔ đích (Alt + V)"/>
                    <Button x:Name="cbClearAreasButton" Tag="clearAreas" Content="🗑 Xóa tất cả vùng" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Xóa tất cả vùng (Alt + R)"/>
                    <Button x:Name="cbClearSelectedAreaButton" Tag="clearSelectedArea" Content="✂ Xóa vùng chọn" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Xóa vùng đã chọn (Alt + H)"/>
                    <Button x:Name="cbExcludeRegionButton" Tag="excludeRegion" Content="⊘ Vùng loại trừ" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Chọn vùng loại trừ (Alt + X)"/>
                    <Button x:Name="cbArea1Button" Tag="area1" Content="① Vùng 1" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Chọn vùng 1 (Alt + 1)"/>
                    <Button x:Name="cbArea2Button" Tag="area2" Content="② Vùng 2" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Chọn vùng 2 (Alt + 2)"/>
                    <Button x:Name="cbArea3Button" Tag="area3" Content="③ Vùng 3" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Chọn vùng 3 (Alt + 3)"/>
                    <Button x:Name="cbArea4Button" Tag="area4" Content="④ Vùng 4" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Chọn vùng 4 (Alt + 4)"/>
                    <Button x:Name="cbArea5Button" Tag="area5" Content="⑤ Vùng 5" Height="28"
                            Style="{StaticResource HeaderButtonStyle}" Click="HotkeyProxyButton_Click"
                            ToolTip="Chọn vùng 5 (Alt + 5)"/>
                </WrapPanel>
            </DockPanel>
        </Border>
        
        <!-- Wrap RichTextBox in a ScrollViewer with better scrollbar placement -->
        <ScrollViewer x:Name="chatScrollViewer" 
                      Margin="0,28,0,30" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#30000000"
                      Padding="0">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <RichTextBox x:Name="chatHistoryText" 
                         Background="Transparent"
                         BorderThickness="0"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="10,10,10,10"
                         Margin="0,0,0,0"
                         AcceptsReturn="True"
                         IsDocumentEnabled="True"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         Foreground="White"
                         Block.LineHeight="Auto">
                <RichTextBox.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="1"/>
                </RichTextBox.Effect>
            </RichTextBox>
        </ScrollViewer>
        
        <!-- Full-content loading overlay: covers the old translation while waiting for the service,
             so it's obvious a fresh translation is on the way (updated margin in HeaderBar_SizeChanged). -->
        <Border x:Name="cbLoadingOverlay" Visibility="Collapsed" Panel.ZIndex="3"
                Background="#E01A1A1A" Margin="0,28,0,30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="52" Height="52">
                    <Ellipse Width="52" Height="52" Stroke="#33FFFFFF" StrokeThickness="5"/>
                    <Path Stroke="#4ADE80" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 26,3 A 23,23 0 0 1 49,26" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="cbSpinnerRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock Text="Đang dịch..." Foreground="White" FontWeight="SemiBold" FontSize="15"
                           Margin="0,16,0,0" HorizontalAlignment="Center"/>
                <TextBlock x:Name="cbLoadingSub" Text="" Foreground="#99CCCCCC" FontSize="11"
                           Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Translation in progress indicator -->
        <Border x:Name="translationStatusPanel"
                Height="30" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Stretch"
                Background="#DD202020"
                BorderThickness="0,1,0,0"
                BorderBrush="#444444"
                Margin="0,0,0,0"
                Visibility="Collapsed"
                Panel.ZIndex="2">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="translationStatusText" 
                               Text="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Status_WaitingTranslation]}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <!-- Loading animation dots với XAML animation -->
                    <Canvas x:Name="loadingCanvas" Width="30" Height="10">
                        <Ellipse x:Name="dot1" Width="6" Height="6" Fill="White" Canvas.Left="0" Canvas.Top="2" Opacity="1">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation 
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0.3" Duration="0:0:0.6" 
                                                        AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse x:Name="dot2" Width="6" Height="6" Fill="White" Canvas.Left="12" Canvas.Top="2" Opacity="0.6">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.2">
                                                    <DoubleAnimation 
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0.3" Duration="0:0:0.6" 
                                                        AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse x:Name="dot3" Width="6" Height="6" Fill="White" Canvas.Left="24" Canvas.Top="2" Opacity="0.3">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.4">
                                                    <DoubleAnimation 
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0.3" Duration="0:0:0.6" 
                                                        AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Canvas>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Toggle borders button -->
        <Button x:Name="toggleBordersButton" 
                Style="{StaticResource ToggleBordersButtonStyle}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Margin="0,30,10,0"
                Panel.ZIndex="3"
                Click="ToggleBordersButton_Click"
                ToolTip="{Binding Source={x:Static local:LocalizationManager.Instance}, Path=Strings[ChatBox_Btn_ToggleBorders_Tooltip]}">
            <Path x:Name="toggleBordersIcon"
                  Data="M 4,2 L 12,2 L 12,6 L 4,6 Z M 4,10 L 12,10 L 12,14 L 4,14 Z"
                  Fill="White"
                  Width="16"
                  Height="16"
                  Stretch="Uniform"/>
        </Button>
        
        <!-- Translating/stopped status indicator (bottom-right) -->
        <Border x:Name="cbStatusIndicator" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,6" Panel.ZIndex="4" Background="#B0202020" CornerRadius="8" Padding="8,3">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="cbStatusDot" Width="10" Height="10" Fill="#DC3C3C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="cbStatusLabel" Text="Đã dừng" Foreground="#FF6B6B" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Resize grip indicator - improved with Path instead of Rectangle -->
        <Path x:Name="resizeGrip"
              Data="M 0,16 L 16,16 L 16,0 L 12,0 L 12,4 L 8,4 L 8,8 L 4,8 L 4,12 L 0,12 Z" 
              Fill="#99FFFFFF"
              HorizontalAlignment="Right" 
              VerticalAlignment="Bottom" 
              Width="16" 
              Height="16"
              Margin="0,0,0,0"/>
    </Grid>
</Window>